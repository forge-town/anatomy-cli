{
  "name": "anatomy-cli-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A Bun monorepo for Anatomy Draft definitions and repository structure checks.",
  "license": "MIT",
  "author": "forge-town",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forge-town/anatomy-cli.git"
  },
  "bugs": {
    "url": "https://github.com/forge-town/anatomy-cli/issues"
  },
  "homepage": "https://anatomy.tools",
  "keywords": [
    "anatomy",
    "bun",
    "schema",
    "filesystem",
    "validation"
  ],
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "anatomy": "bun run apps/anatomy-cli/src/main.ts",
    "anatomy-cli": "bun run apps/anatomy-cli/src/main.ts",
    "docs:dev": "bun --cwd apps/docs dev",
    "docs:build": "bun --cwd apps/docs build",
    "docs:build:cloudflare": "bun --cwd apps/docs build:cloudflare",
    "docs:preview:cloudflare": "bun --cwd apps/docs preview:cloudflare",
    "docs:deploy:cloudflare": "bun --cwd apps/docs deploy:cloudflare",
    "docs:preview": "bun --cwd apps/docs serve",
    "docs:check-types": "bun --cwd apps/docs check-types",
    "docs:lint": "bun --cwd apps/docs lint",
    "build": "bun run --filter 'anatomy-cli' build",
    "check-types": "bunx --no-install tsc --noEmit && bun run --filter '*' check-types",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "quality": "bun run check-types && bun run lint && bun run test && bun run build"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11",
  "devDependencies": {
    "@anatomy-cli/anatomy": "workspace:*",
    "@anatomy-cli/config": "workspace:*",
    "@anatomy-cli/schemas": "workspace:*",
    "@types/node": "^25.9.2",
    "anatomy-cli": "workspace:*",
    "oxlint": "^1.59.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "^4.1.8"
  }
}
