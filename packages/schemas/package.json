{
  "name": "@anatomy-cli/schemas",
  "version": "0.1.0",
  "description": "Runtime Zod schemas for Anatomy Draft definitions.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anatomy": {
      "types": "./dist/anatomy/index.d.ts",
      "default": "./dist/anatomy/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "default": "./dist/composition/index.js"
    },
    "./anatomy/*": {
      "types": "./dist/anatomy/*.d.ts",
      "default": "./dist/anatomy/*.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run --passWithNoTests",
    "quality": "bun run check-types && bun run lint && bun run test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "oxlint": "^1.59.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "private": true
}
