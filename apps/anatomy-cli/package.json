{
  "name": "@anatomy-cli/cli",
  "version": "0.1.0",
  "description": "Scan repository file trees against Anatomy Draft definitions.",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "anatomies"
  ],
  "bin": {
    "anatomy-cli": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "scan:self": "bun src/main.ts --definition ../../packages/anatomy-cli-config/src/anatomies/zod-schema.anatomy.json --target ../../packages/schemas/src/anatomy",
    "scan:schemas": "bun src/main.ts --definition ../../packages/anatomy-cli-config/src/anatomies/schemas.anatomy.json --target ../../packages/schemas",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "quality": "bun run check-types && bun run lint && bun run test"
  },
  "dependencies": {
    "@anatomy-cli/anatomy": "workspace:*",
    "@anatomy-cli/schemas": "workspace:*",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "oxlint": "^1.59.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.8"
  }
}
