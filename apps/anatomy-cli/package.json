{
  "name": "anatomy-cli",
  "version": "0.0.3",
  "description": "Scan repository file trees against Anatomy Draft definitions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forge-town/anatomy-cli.git",
    "directory": "apps/anatomy-cli"
  },
  "bugs": {
    "url": "https://github.com/forge-town/anatomy-cli/issues"
  },
  "homepage": "https://anatomy.tools",
  "keywords": [
    "anatomy",
    "cli",
    "validation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "anatomies"
  ],
  "bin": {
    "anatomy-cli": "./bin/anatomy-cli.js",
    "anatomy": "./bin/anatomy.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --outfile=dist/main.js && bun build src/index.ts --target=node --outfile=dist/index.js && bun build src/install-main.ts --target=node --outfile=dist/install-main.js",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "scan:self": "bun src/main.ts ../../packages/schemas/src/anatomy --definition ../../packages/anatomy-cli-config/src/anatomies/zod-schema.anatomy.json",
    "scan:schemas": "bun src/main.ts ../../packages/schemas --definition ../../packages/anatomy-cli-config/src/anatomies/schemas.anatomy.json",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "quality": "bun run check-types && bun run lint && bun run test && bun run build",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@anatomy-cli/anatomy": "workspace:*",
    "@anatomy-cli/schemas": "workspace:*",
    "neverthrow": "^8.2.0",
    "@types/node": "^25.9.2",
    "oxlint": "^1.59.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.8"
  }
}
