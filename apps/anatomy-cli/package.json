{
  "name": "anatomy-cli",
  "version": "0.0.2",
  "description": "Anatomy CLI and SDK for repository structure and source export validation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forge-town/anatomy-cli.git",
    "directory": "apps/anatomy-cli"
  },
  "bugs": {
    "url": "https://github.com/forge-town/anatomy-cli/issues"
  },
  "homepage": "https://anatomy.tools",
  "keywords": [
    "anatomy",
    "cli",
    "validation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "bin",
    "dist",
    "anatomies"
  ],
  "bin": {
    "anatomy-cli": "./bin/anatomy-cli.js",
    "anatomy": "./bin/anatomy.js"
  },
  "exports": {
    ".": {
      "types": "./dist/apps/anatomy-cli/src/index.d.ts",
      "default": "./dist/apps/anatomy-cli/src/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun src/build-main.ts && bun build src/main.ts --target=node --outfile=dist/main.js && bun build src/install-main.ts --target=node --outfile=dist/install-main.js",
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "scan:self": "bun src/main.ts ../.. --git-files",
    "scan:schemas": "bun src/main.ts ../../packages/schemas --git-files",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "quality": "bun run scan:self && bun run check-types && bun run lint && bun run test && bun run build",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "oxlint": "^1.59.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.8"
  },
  "types": "./dist/apps/anatomy-cli/src/index.d.ts",
  "dependencies": {
    "neverthrow": "^8.2.0",
    "zod": "^4.3.6",
    "typescript": "5.9.2"
  }
}
